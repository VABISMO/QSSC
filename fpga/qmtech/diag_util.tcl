## ---------------------------------------------------------------------------
## diag_util.tcl -- why does the QMTECH port not fit the XC7A15T?
##
## Runs synthesis ONLY (no place/route) and dumps a HIERARCHICAL utilisation
## report, so we can see which module consumes the LUTs instead of guessing.
## Cheap: ~2 min, ~3 GB.
##
##   vivado -mode batch -nojournal -log ... -source diag_util.tcl
## ---------------------------------------------------------------------------
set HERE [file normalize [file dirname [info script]]]
set ROOT [file normalize "$HERE/../.."]
set RTL  [file join $ROOT fpga rtl]
set OUT  [file join $HERE build]

file mkdir $OUT

# Same ODDR2 patch as the real build (read the helper the build writes).
set top_in [file join $RTL top_level.v]
set fh  [open $top_in r]; set txt [read $fh]; close $fh
set re {ODDR2\s*#.*?\.Q\s*\(refclk_out\)\)\s*;}
if {[regexp $re $txt]} {
    set txt [regsub $re $txt "assign refclk_out = refclk_25m;  // XC7 PATCH"]
}
set top_patched [file join $OUT top_level_xc7.v]
set fh [open $top_patched w]
puts  $fh "// generated by diag_util.tcl - DO NOT EDIT"
puts  $fh $txt
close $fh

foreach f {uart_rx.v uart_tx.v spi_master.v tlc5947_ctrl.v emitter_array.v \
           adc_reader.v adf4351_ctrl.v qrng_entropy.v dac_ctrl.v command_parser.v} {
    read_verilog [file join $RTL $f]
}
read_verilog $top_patched
read_verilog [file join $HERE top_qmtech.v]
read_xdc     [file join $HERE constraints_qmtech.xdc]

# Synthesis only.  Stop before any DRC/implementation so the report is written
# even when the design does not fit.
synth_design -top top_qmtech -part xc7a15tcsg325-1

report_utilization -hierarchical -file [file join $OUT diag_util_hier.rpt]
report_utilization                -file [file join $OUT diag_util_flat.rpt]

# Put the interesting part of the hierarchical report on the console.
set fh [open [file join $OUT diag_util_hier.rpt] r]
set rpt [read $fh]; close $fh
foreach line [split $rv $rv] { }
puts "=== TOP OF HIERARCHICAL UTILISATION ==="
set n 0
foreach line [split $rpt "\n"] {
    incr n
    if {$n <= 70} { puts $line }
}
puts "=== END (full report in build/diag_util_hier.rpt) ==="
