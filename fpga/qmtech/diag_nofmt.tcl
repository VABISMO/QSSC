## ---------------------------------------------------------------------------
## diag_nofmt.tcl -- measurement: how much do the combinational decimal
## formatters cost, and does the design FIT the XC7A15T without them?
##
## Runs stub_formatters.py first (separate step), then synthesises the design
## with build/command_parser_nofmt.v instead of rtl/command_parser.v, and then
## actually calls place_design -- the command that previously aborted with
## [DRC UTLZ-1] LUT over-utilized.  If place_design runs, the design fits.
##
## DIAGNOSTIC ONLY: the resulting netlist is NOT functional (all decimal
## replies would print zero).  Nothing outside build/ is touched.
##
##   python3 fpga/qmtech/stub_formatters.py
##   vivado -mode batch -nojournal -log build/diag_nofmt.log -source diag_nofmt.tcl
## ---------------------------------------------------------------------------
set HERE [file normalize [file dirname [info script]]]
set ROOT [file normalize "$HERE/../.."]
set RTL  [file join $ROOT fpga rtl]
set OUT  [file join $HERE build]

file mkdir $OUT

set nofmt [file join $OUT command_parser_nofmt.v]
if {![file exists $nofmt]} {
    error "$nofmt missing -- run stub_formatters.py first"
}
puts "INFO: using stubbed command_parser: $nofmt"

# --- same ODDR2 patch as the real build -------------------------------------
set top_in [file join $RTL top_level.v]
set fh  [open $top_in r]; set txt [read $fh]; close $fh
set re {ODDR2\s*#.*?\.Q\s*\(refclk_out\)\)\s*;}
if {[regexp $re $txt]} {
    set txt [regsub $re $txt "assign refclk_out = refclk_25m;  // XC7 PATCH"]
}
set top_patched [file join $OUT top_level_xc7.v]
set fh [open $top_patched w]
puts  $fh "// generated by diag_nofmt.tcl - DO NOT EDIT"
puts  $fh $txt
close $fh

# --- RTL (command_parser comes from the stubbed copy) -----------------------
foreach f {uart_rx.v uart_tx.v spi_master.v tlc5947_ctrl.v emitter_array.v \
           adc_reader.v adf4351_ctrl.v qrng_entropy.v dac_ctrl.v} {
    read_verilog [file join $RTL $f]
}
read_verilog $nofmt
read_verilog $top_patched
read_verilog [file join $HERE top_qmtech.v]
read_xdc     [file join $HERE constraints_qmtech.xdc]

synth_design -top top_qmtech -part xc7a15tcsg325-1

report_utilization -hierarchical -file [file join $OUT nofmt_util_hier.rpt]
report_utilization                -file [file join $OUT nofmt_util_flat.rpt]

# --- the decisive test -------------------------------------------------------
# place_design runs [DRC UTLZ-1] first; previously it refused to run at all.
if {[catch {place_design} err]} {
    puts "FIT_RESULT=NO : place_design failed: $err"
} else {
    puts "FIT_RESULT=YES: place_design completed"
    report_utilization -file [file join $OUT nofmt_util_placed.rpt]
}

# --- headline numbers --------------------------------------------------------
set fh [open [file join $OUT nofmt_util_flat.rpt] r]
set rpt [read $fh]; close $fh
foreach line [split $rpt "\n"] {
    if {[regexp {\|\s*Slice LUTs\s*\|\s*(\d+)} $line -> v]} {
        puts "LUT_SLICE_LUTS=$v (limit 10400)"
    }
    if {[regexp {\|\s*LUT as Logic\s*\|\s*(\d+)} $line -> v]} {
        puts "LUT_AS_LOGIC=$v (limit 10400)"
    }
}
puts "=== DONE: see build/nofmt_util_hier.rpt ==="
